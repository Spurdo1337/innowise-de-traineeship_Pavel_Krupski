# Snowflake
# NOTE: if your password contains a double-quote character ("), escape it
# as \" - it is substituted directly into a JSON string
# (AIRFLOW_CONN_SNOWFLAKE_DEFAULT) in docker-compose.yml.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=AIRLINE_DWH_WH
SNOWFLAKE_DATABASE=AIRLINE_DWH

# Airflow
# AIRFLOW_UID: set this to your host user's UID (run `id -u` on Linux) so
# files Airflow writes into the mounted ./logs volume are owned by you,
# not by whatever UID happens to be baked into the base image.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=airflow
# CHANGE THIS - the Airflow webserver is exposed on localhost:8080 with
# this login. Fine to leave as-is only for a fully local, single-user demo.
AIRFLOW_ADMIN_PASSWORD=change_me_before_use
AIRFLOW_ADMIN_EMAIL=airflow@example.com
