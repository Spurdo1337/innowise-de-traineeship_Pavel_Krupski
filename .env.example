# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. .env is git-ignored.
# ---------------------------------------------------------------------------

# Snowflake account used to provision the project (admin access, humans only).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=SADA_WH
SNOWFLAKE_DATABASE=SADA

# Service user used by Airflow and dbt (development role, no admin access).
AIRFLOW_SF_USER=AIRFLOW_SVC
AIRFLOW_SF_PASSWORD=

# Service user used by Airbyte to land raw data in Snowflake.
AIRBYTE_SF_USER=AIRBYTE_SVC
AIRBYTE_SF_PASSWORD=

# Airflow UI login and internal API signing key.
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=airflow@example.com
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW_UID=50000

# Airbyte API.
# Airbyte Cloud: https://api.airbyte.com/v1 (client id/secret come from
# Settings -> Applications).
# Self-managed: http://localhost:8000/api/public/v1
AIRBYTE_API_BASE=https://api.airbyte.com/v1
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_WORKSPACE_NAME=

# Public TCP endpoints of the tunnels to the local databases. For example
# `ngrok tcp 5433` / `bore local 5433 --to bore.pub`. Airbyte Cloud cannot
# reach localhost, and airbyte/setup_airbyte.py checks these endpoints before
# creating the sources.
PAGILA_SOURCE_HOST=
PAGILA_SOURCE_PORT=
SAKILA_SOURCE_HOST=
SAKILA_SOURCE_PORT=

# Read-only users created by the setup DAGs for Airbyte.
PAGILA_READER_PASSWORD=
SAKILA_READER_PASSWORD=
